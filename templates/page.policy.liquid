{% comment %}
  Template: Policy Page (Terms, Privacy, Cookies)
  SSENSE Luxury Footwear Atelier Brand Legal & Policies
{% endcomment %}

<div class="w-full min-h-[85vh] bg-[#ededed] text-[#111111] py-12 px-4 md:px-12">
  <div class="max-w-[1000px] mx-auto space-y-10">
    
    <!-- Top Header -->
    <div class="pb-6 border-b border-[#dedede] space-y-2">
      <div class="flex items-center gap-2 text-xs font-bold text-[#777777] uppercase tracking-wider">
        <a href="/" class="hover:text-[#111111] transition-colors">HOME</a>
        <span>/</span>
        <span>POLICIES</span>
      </div>
      <h1 class="text-3xl md:text-5xl font-black uppercase tracking-tight font-sans text-[#111111]">
        {{ policy_title | default: 'ATELIER POLICIES' }}
      </h1>
      <p class="text-xs font-semibold text-[#777777] uppercase tracking-widest">
        LAST UPDATED: {{ 'now' | date: '%B %d, %Y' }} • SSENSE LUXURY FOOTWEAR
      </p>
    </div>

    <!-- Policy Content Card -->
    <div class="bg-white p-8 md:p-12 rounded-3xl border border-[#dedede] shadow-sm space-y-8 text-sm leading-relaxed text-[#333333]">
      {{ policy_body }}
      
      <!-- Concierge Assistance Banner -->
      <div class="pt-8 border-t border-[#dedede] flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
          <h4 class="text-xs font-black uppercase tracking-wider text-[#111111]">HAVE QUESTIONS CONCERNING OUR POLICIES?</h4>
          <p class="text-xs text-[#777777] mt-0.5">Our client concierge team is available 24/7 to assist you.</p>
        </div>
        <a href="/contact" class="px-6 py-2.5 bg-[#111111] text-white rounded-xl text-xs font-bold uppercase tracking-wider hover:bg-black/80 transition-colors shadow-sm">
          CONTACT CONCIERGE
        </a>
      </div>
    </div>

  </div>
</div>
