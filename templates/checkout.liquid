{% comment %}
  Template: Checkout Page
  SSENSE Luxury Footwear Seamless Checkout
{% endcomment %}

<div class="w-full min-h-[85vh] bg-[#ededed] text-[#111111] py-12 px-4 md:px-12">
  <div class="max-w-[1200px] mx-auto space-y-8">
    
    <!-- Top Header -->
    <div class="flex justify-between items-baseline pb-6 border-b border-[#dedede]">
      <div>
        <h1 class="text-3xl md:text-5xl font-black uppercase tracking-tight font-sans">
          EXPRESS CHECKOUT
        </h1>
        <p class="text-xs font-semibold text-[#777777] mt-1">
          SECURE 256-BIT ENCRYPTED ATELIER TRANSACTION
        </p>
      </div>

      <a href="/cart" class="text-xs font-bold tracking-widest text-[#111111] hover:underline uppercase">
        ← BACK TO BAG
      </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <!-- Checkout Form (Left 7 Cols) -->
      <div class="lg:col-span-7 bg-white p-8 md:p-10 rounded-3xl border border-[#dedede] shadow-sm space-y-8">
        
        <!-- Contact Information -->
        <div class="space-y-4">
          <h2 class="text-sm font-black uppercase tracking-wider text-[#111111] pb-2 border-b border-[#f0f0f0]">
            1. CONTACT INFORMATION
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-[11px] font-bold text-[#777777] uppercase mb-1">First Name *</label>
              <input type="text" required placeholder="Alex" class="w-full px-4 py-2.5 bg-[#f9f9f9] border border-[#dedede] rounded-xl text-xs font-semibold focus:outline-none focus:border-black" />
            </div>
            <div>
              <label class="block text-[11px] font-bold text-[#777777] uppercase mb-1">Last Name *</label>
              <input type="text" required placeholder="Laurent" class="w-full px-4 py-2.5 bg-[#f9f9f9] border border-[#dedede] rounded-xl text-xs font-semibold focus:outline-none focus:border-black" />
            </div>
          </div>
          <div>
            <label class="block text-[11px] font-bold text-[#777777] uppercase mb-1">Email Address *</label>
            <input type="email" required placeholder="alex.laurent@luxury.com" class="w-full px-4 py-2.5 bg-[#f9f9f9] border border-[#dedede] rounded-xl text-xs font-semibold focus:outline-none focus:border-black" />
          </div>
        </div>

        <!-- Shipping Address -->
        <div class="space-y-4">
          <h2 class="text-sm font-black uppercase tracking-wider text-[#111111] pb-2 border-b border-[#f0f0f0]">
            2. DELIVERY ADDRESS
          </h2>
          <div>
            <label class="block text-[11px] font-bold text-[#777777] uppercase mb-1">Street Address *</label>
            <input type="text" required placeholder="124 Rue du Faubourg Saint-Honoré" class="w-full px-4 py-2.5 bg-[#f9f9f9] border border-[#dedede] rounded-xl text-xs font-semibold focus:outline-none focus:border-black" />
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
              <label class="block text-[11px] font-bold text-[#777777] uppercase mb-1">City *</label>
              <input type="text" required placeholder="Paris" class="w-full px-4 py-2.5 bg-[#f9f9f9] border border-[#dedede] rounded-xl text-xs font-semibold focus:outline-none focus:border-black" />
            </div>
            <div>
              <label class="block text-[11px] font-bold text-[#777777] uppercase mb-1">Postal Code *</label>
              <input type="text" required placeholder="75008" class="w-full px-4 py-2.5 bg-[#f9f9f9] border border-[#dedede] rounded-xl text-xs font-semibold focus:outline-none focus:border-black" />
            </div>
            <div>
              <label class="block text-[11px] font-bold text-[#777777] uppercase mb-1">Country *</label>
              <select class="w-full px-4 py-2.5 bg-[#f9f9f9] border border-[#dedede] rounded-xl text-xs font-semibold focus:outline-none focus:border-black">
                <option>France</option>
                <option>United States</option>
                <option>United Kingdom</option>
                <option>Canada</option>
                <option>Germany</option>
                <option>Italy</option>
                <option>Japan</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Payment Method -->
        <div class="space-y-4">
          <h2 class="text-sm font-black uppercase tracking-wider text-[#111111] pb-2 border-b border-[#f0f0f0]">
            3. PAYMENT METHOD
          </h2>
          <div class="p-4 rounded-xl border border-black bg-black/5 flex justify-between items-center">
            <span class="text-xs font-bold text-[#111111]">CREDIT CARD (SIMULATION)</span>
            <span class="text-xs text-[#777777]">VISA / MC / AMEX</span>
          </div>
          <div class="space-y-3">
            <input type="text" placeholder="Card Number (4242 •••• •••• 4242)" class="w-full px-4 py-2.5 bg-[#f9f9f9] border border-[#dedede] rounded-xl text-xs font-semibold focus:outline-none focus:border-black" />
            <div class="grid grid-cols-2 gap-4">
              <input type="text" placeholder="MM / YY" class="w-full px-4 py-2.5 bg-[#f9f9f9] border border-[#dedede] rounded-xl text-xs font-semibold focus:outline-none focus:border-black" />
              <input type="text" placeholder="CVV" class="w-full px-4 py-2.5 bg-[#f9f9f9] border border-[#dedede] rounded-xl text-xs font-semibold focus:outline-none focus:border-black" />
            </div>
          </div>
        </div>

        <!-- Submit Button -->
        <form action="/checkout/complete" method="post" onsubmit="event.preventDefault(); window.completeCheckout();">
          <button 
            type="submit" 
            id="btn-place-order"
            class="w-full py-4 bg-[#111111] text-white hover:bg-black/80 rounded-xl text-xs font-bold tracking-widest uppercase transition-all shadow-lg cursor-pointer"
          >
            CONFIRM & PLACE ORDER ({{ cart.total_price | money }})
          </button>
        </form>

        <div id="checkout-success-banner" class="hidden p-6 bg-emerald-50 border border-emerald-300 rounded-2xl text-center space-y-3">
          <div class="text-3xl">✓</div>
          <h3 class="text-base font-black text-emerald-900 uppercase">ORDER CONFIRMED</h3>
          <p class="text-xs text-emerald-700">Thank you for your order! Your confirmation #WS-{{ 'now' | date: '%s' | slice: -6, 6 }} has been dispatched to your email.</p>
          <a href="/" class="inline-block px-6 py-2.5 bg-[#111111] text-white rounded-xl text-xs font-bold tracking-widest uppercase mt-2">CONTINUE SHOPPING</a>
        </div>

      </div>

      <!-- Order Summary (Right 5 Cols) -->
      <div class="lg:col-span-5 space-y-6">
        <div class="p-6 bg-white rounded-2xl border border-[#dedede] space-y-6">
          <h2 class="text-base font-black uppercase tracking-tight text-[#111111] pb-4 border-b border-[#dedede]">
            ORDER ITEMS ({{ cart.item_count }})
          </h2>

          <div class="space-y-4 max-h-[360px] overflow-y-auto pr-1">
            {% for item in cart.items %}
              <div class="flex gap-4 items-center">
                <div class="w-16 h-16 bg-[#f9f9f9] rounded-lg p-1 flex-shrink-0 flex items-center justify-center">
                  <img src="{{ item.image_primary | default: '70.png' | asset_url }}" class="w-full h-full object-contain" />
                </div>
                <div class="flex-1 min-w-0">
                  <h4 class="text-xs font-black uppercase truncate text-[#111111]">{{ item.title }}</h4>
                  <p class="text-[11px] text-[#777777]">Qty: {{ item.quantity }}</p>
                </div>
                <span class="text-xs font-black text-[#111111]">{{ item.price_formatted | default: '$20.00' }}</span>
              </div>
            {% endfor %}
            {% if cart.item_count == 0 %}
              <p class="text-xs text-[#777777]">No items currently in selection.</p>
            {% endif %}
          </div>

          <div class="pt-4 border-t border-[#dedede] space-y-2 text-xs font-semibold">
            <div class="flex justify-between text-[#555555]">
              <span>SUBTOTAL</span>
              <span class="text-sm font-black text-[#111111]">{{ cart.total_price | money }}</span>
            </div>
            <div class="flex justify-between text-[#555555]">
              <span>EXPRESS DELIVERY</span>
              <span class="text-emerald-700 font-bold">FREE</span>
            </div>
            <div class="flex justify-between items-baseline pt-4 border-t border-[#dedede]">
              <span class="text-sm font-black text-[#111111]">TOTAL</span>
              <span class="text-2xl font-black text-[#111111]">{{ cart.total_price | money }}</span>
            </div>
          </div>
        </div>
      </div>

    </div>

  </div>
</div>

<script>
  window.completeCheckout = function() {
    const btn = document.getElementById('btn-place-order');
    const banner = document.getElementById('checkout-success-banner');
    if (btn) btn.style.display = 'none';
    if (banner) banner.classList.remove('hidden');
    // Clear cart in backend
    fetch('/cart/clear.js', { method: 'POST' }).catch(() => {});
  };
</script>
