{% comment %}
  Template: Wishlist Page
  SSENSE Luxury Footwear Wishlist Experience
{% endcomment %}

<div class="w-full min-h-[85vh] bg-[#ededed] text-[#111111] py-10 px-4 md:px-12">
  <div class="max-w-[1400px] mx-auto space-y-8">
    
    <!-- Top Header -->
    <div class="flex justify-between items-baseline pb-6 border-b border-[#dedede]">
      <div>
        <h1 class="text-3xl md:text-5xl font-black uppercase tracking-tight font-sans">
          WISHLIST
        </h1>
        <p class="text-xs font-semibold text-[#777777] mt-1">
          <span id="wishlist-count-text">0 ITEMS</span> IN YOUR WISHLIST
        </p>
      </div>

      <a href="/" class="text-xs font-bold tracking-widest text-[#111111] hover:underline uppercase">
        ← CONTINUE SHOPPING
      </a>
    </div>

    <!-- Wishlist Grid Container (Populated dynamically by footwear-core.js) -->
    <div id="wishlist-items-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      <!-- Dynamic Wishlist Cards rendered here -->
    </div>

    <!-- Empty Wishlist State -->
    <div id="wishlist-empty-state" class="hidden text-center py-20 bg-white rounded-3xl border border-[#dedede] space-y-6">
      <div class="w-16 h-16 mx-auto bg-[#ededed] rounded-full flex items-center justify-center text-2xl text-[#777777]">
        ♡
      </div>
      <div class="space-y-2">
        <h2 class="text-2xl font-black uppercase text-[#111111]">YOUR WISHLIST IS EMPTY</h2>
        <p class="text-xs text-[#777777] max-w-sm mx-auto">Explore our luxury footwear collection and heart your favorite shoes to save them here.</p>
      </div>
      <div>
        <a href="/" class="inline-block px-8 py-3.5 bg-[#111111] text-white rounded-xl text-xs font-bold tracking-widest uppercase hover:bg-black/80 transition-all shadow-md">
          EXPLORE FOOTWEAR
        </a>
      </div>
    </div>

  </div>
</div>
