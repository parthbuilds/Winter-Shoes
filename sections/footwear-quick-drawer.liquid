{% comment %}
  Section: Footwear Quick Drawer
  Sliding side panel triggered by "See More" with dynamic shoe size picker,
  stock indicators, AJAX Add-to-Bag, and collapsible accordions.
{% endcomment %}

<div 
  id="quick-drawer-backdrop" 
  class="drawer-backdrop fixed inset-0 z-50 hidden justify-end opacity-0 transition-opacity duration-300"
  aria-hidden="true"
>
  <!-- Sliding Panel Container (GSAP xPercent: 100 -> 0) -->
  <div 
    id="quick-drawer-sheet" 
    class="w-full max-w-lg md:max-w-xl h-full bg-[#0e0e12] border-l border-zinc-800 text-white shadow-2xl flex flex-col justify-between overflow-y-auto transform translate-x-full"
    role="dialog"
    aria-modal="true"
    aria-labelledby="drawer-shoe-title"
  >
    <!-- Drawer Header -->
    <div class="p-6 pb-4 border-b border-zinc-800/80 flex items-center justify-between sticky top-0 bg-[#0e0e12]/95 backdrop-blur-md z-20">
      <div class="flex items-center space-x-2">
        <span class="inline-block w-2 h-2 rounded-full bg-orange-500"></span>
        <span id="drawer-shoe-category" class="text-xs font-mono tracking-widest text-zinc-400 uppercase font-bold">
          SNEAKERS
        </span>
      </div>

      <button 
        id="quick-drawer-close" 
        type="button" 
        class="w-8 h-8 rounded-full bg-zinc-900 border border-zinc-700/60 text-zinc-400 hover:text-white hover:border-zinc-500 flex items-center justify-center transition-all cursor-pointer"
        aria-label="Close drawer"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Drawer Body -->
    <div class="p-6 space-y-6 flex-1">
      <!-- Product Featured Image & Title -->
      <div class="space-y-4">
        <div class="relative w-full aspect-[4/3] rounded-2xl overflow-hidden bg-gradient-to-b from-zinc-900 to-zinc-950 flex items-center justify-center p-6 border border-zinc-800/60">
          <img 
            id="drawer-shoe-image" 
            src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=600&q=80" 
            alt="Shoe preview" 
            class="max-h-full max-w-full object-contain drop-shadow-[0_20px_30px_rgba(0,0,0,0.9)]"
          />
        </div>

        <div class="flex justify-between items-start pt-2">
          <div>
            <h2 id="drawer-shoe-title" class="text-2xl font-bold font-display text-white tracking-tight">
              Aura Proto Runner
            </h2>
            <p id="drawer-shoe-material" class="text-xs text-zinc-400 mt-1">
              Full-Grain Italian Calfskin • Custom Molded Sole
            </p>
          </div>
          <div id="drawer-shoe-price" class="text-xl font-bold font-display text-white">
            $680.00
          </div>
        </div>
      </div>

      <!-- Size Selector (EU 39 - 46) -->
      <div class="space-y-3 pt-2">
        <div class="flex justify-between items-center text-xs">
          <span class="font-bold tracking-wider uppercase text-zinc-300">SELECT SIZE (EU / US)</span>
          <span id="drawer-stock-badge" class="text-orange-400 font-mono text-[11px]">Only 2 pairs left in Size 43</span>
        </div>

        <div class="grid grid-cols-4 gap-2" id="drawer-size-selector-grid">
          {% assign sizes = "39,40,41,42,43,44,45,46" | split: "," %}
          {% for size in sizes %}
            <button 
              type="button" 
              class="drawer-size-btn py-3 rounded-xl border text-xs font-semibold tracking-wider transition-all duration-200 cursor-pointer {% if size == '43' %}bg-white text-black border-white font-bold{% else %}bg-zinc-900/90 text-zinc-300 border-zinc-800 hover:border-zinc-500{% endif %}"
              data-size="{{ size }}"
            >
              EU {{ size }}
            </button>
          {% endfor %}
        </div>
      </div>

      <!-- Color Swatches -->
      <div class="space-y-2.5 pt-2">
        <span class="text-xs font-bold tracking-wider uppercase text-zinc-300">COLORWAY</span>
        <div class="flex items-center space-x-3">
          <button class="w-8 h-8 rounded-full bg-zinc-950 border-2 border-orange-500 ring-2 ring-orange-500/20" title="Obsidian / Solar Orange"></button>
          <button class="w-8 h-8 rounded-full bg-[#f4f4f6] border border-zinc-700 hover:border-zinc-400 transition-colors" title="Pure White / Chrome"></button>
          <button class="w-8 h-8 rounded-full bg-[#4a3728] border border-zinc-700 hover:border-zinc-400 transition-colors" title="Espresso Burnished Leather"></button>
        </div>
      </div>

      <!-- Collapsible Accordions: Details, Shipping, Reviews -->
      <div class="border-t border-zinc-800/80 pt-4 space-y-3">
        <!-- Accordion 1: Details & Craftsmanship -->
        <div class="border-b border-zinc-800/60 pb-3">
          <button type="button" class="drawer-accordion-header w-full flex justify-between items-center text-xs font-bold uppercase tracking-wider text-zinc-200 py-1.5 cursor-pointer">
            <span>DETAILS & CRAFTSMANSHIP</span>
            <svg class="accordion-icon w-4 h-4 text-zinc-400 transform transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="drawer-accordion-content text-xs text-zinc-400 space-y-2 mt-2 leading-relaxed">
            <p>• Premium vegetable-tanned Italian calf leather with micro-perforations for breathability.</p>
            <p>• Custom ergonomic footbed lined with antibacterial microfiber memory foam.</p>
            <p>• Hand-stitched welt construction engineered for over 100,000 continuous flex cycles.</p>
          </div>
        </div>

        <!-- Accordion 2: Free Delivery & Returns -->
        <div class="border-b border-zinc-800/60 pb-3">
          <button type="button" class="drawer-accordion-header w-full flex justify-between items-center text-xs font-bold uppercase tracking-wider text-zinc-200 py-1.5 cursor-pointer">
            <span>FREE DELIVERY & COMPLIMENTARY RETURNS</span>
            <svg class="accordion-icon w-4 h-4 text-zinc-400 transform transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="drawer-accordion-content hidden text-xs text-zinc-400 space-y-2 mt-2 leading-relaxed">
            <p>• Complimentary express DHL worldwide shipping on all footwear orders.</p>
            <p>• 30-day hassle-free return window with prepaid pickup label included in the luxury presentation box.</p>
          </div>
        </div>

        <!-- Accordion 3: Reviews -->
        <div class="border-b border-zinc-800/60 pb-3">
          <button type="button" class="drawer-accordion-header w-full flex justify-between items-center text-xs font-bold uppercase tracking-wider text-zinc-200 py-1.5 cursor-pointer">
            <span>CLIENT REVIEWS (4.9 / 5.0)</span>
            <svg class="accordion-icon w-4 h-4 text-zinc-400 transform transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="drawer-accordion-content hidden text-xs text-zinc-400 space-y-3 mt-2">
            <div class="bg-zinc-900/60 p-3 rounded-xl">
              <div class="flex justify-between items-center mb-1">
                <span class="text-white font-semibold text-[11px]">Julian M. (Verified Buyer)</span>
                <span class="text-amber-400 text-[10px]">★★★★★</span>
              </div>
              <p class="text-zinc-400 text-[11px]">"The silhouette looks even sharper in person. Fits true to size with exceptional arch support."</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Drawer Footer: AJAX Add To Cart CTA -->
    <div class="p-6 border-t border-zinc-800 bg-[#0e0e12]/95 backdrop-blur-md sticky bottom-0 z-20">
      <button 
        id="drawer-add-to-cart-btn"
        type="button" 
        class="w-full py-4 px-6 bg-white hover:bg-orange-500 hover:text-black text-black font-extrabold text-xs tracking-widest uppercase rounded-2xl transition-all duration-200 flex items-center justify-center gap-2 shadow-xl cursor-pointer"
        data-product-id="1"
      >
        <span>ADD TO BAG — $680.00</span>
      </button>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Footwear Quick Drawer",
  "settings": [
    {
      "type": "text",
      "id": "shipping_policy_title",
      "label": "Shipping Accordion Title",
      "default": "FREE DELIVERY & COMPLIMENTARY RETURNS"
    },
    {
      "type": "textarea",
      "id": "shipping_policy_content",
      "label": "Shipping Policy Details",
      "default": "Complimentary express DHL worldwide shipping on all footwear orders. 30-day return window."
    }
  ]
}
{% endschema %}
