{% comment %}
  Section: Footwear Collection Grid View
  - Dedicated Responsive Grid with Dual Image Hover Animation
  - Clean Back to Carousel transition
  - Dynamic Shopify Product Cards with Brand, Title, Price, and Image Hover State
{% endcomment %}

{% assign grid_products = collections.all.products %}
{% if grid_products == blank or grid_products.size == 0 %}
  {% assign grid_products = collections['shoes'].products %}
{% endif %}
{% if grid_products == blank or grid_products.size == 0 %}
  {% assign grid_products = collections['winter-shoes'].products %}
{% endif %}
{% if grid_products == blank or grid_products.size == 0 %}
  {% assign grid_products = collections[section.settings.collection].products %}
{% endif %}

<section 
  id="collection-grid-section"
  class="relative w-full min-h-[85vh] bg-[#ededed] text-[#111111] py-8 px-4 md:px-12 hidden opacity-0 transition-opacity duration-500"
  data-section-id="{{ section.id }}"
  data-section-type="footwear-collection-grid"
>
  <div class="max-w-[1680px] mx-auto space-y-8">
    
    <!-- Top Row: Section Heading & Search Filter -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 pb-6 border-b border-[#dedede]">
      <div>
        <h2 class="text-3xl md:text-4xl font-black uppercase tracking-tight font-sans text-[#111111]">
          FOOTWEAR COLLECTION
        </h2>
        <p class="text-xs font-sans font-semibold text-[#777777] mt-1">
          Showing luxury footwear curated for your atelier
        </p>
      </div>

      <!-- Quick Filter Search Input -->
      <div class="relative w-full md:w-64">
        <span class="absolute inset-y-0 left-0 flex items-center pointer-events-none text-xs text-[#888888]">
          ⌕
        </span>
        <input 
          type="text" 
          id="grid-search-input"
          placeholder="FILTER PRODUCTS..." 
          class="w-full pl-5 pr-3 py-1.5 bg-transparent text-xs font-sans tracking-widest uppercase text-[#111111] placeholder-[#888888] border-b border-[#cccccc] focus:border-[#111111] focus:outline-none transition-colors"
        />
      </div>
    </div>

    <!-- 3-Column Responsive Product Card Grid -->
    <div id="product-cards-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      
      {% if grid_products != blank and grid_products.size > 0 %}
        {% for product in grid_products %}
          {% assign img_1 = product.featured_image %}
          {% assign img_2 = product.images[1] | default: product.featured_image %}
          
          <div 
            class="shoe-card-item product-grid-item flex flex-col justify-between p-6 bg-white rounded-2xl border border-[#dedede] cursor-pointer hover:border-black transition-all relative" 
            data-product-id="{{ product.id }}" 
            data-category="{{ product.type | default: 'sneakers' | downcase }}"
            onclick="window.showProductDetail({{ product.id | json }})"
          >
            <div class="relative w-full aspect-[4/3] flex items-center justify-center p-4 overflow-hidden">
              <!-- Wishlist Heart Button -->
              <button 
                type="button" 
                class="wishlist-btn absolute top-1 right-1 z-20 w-8 h-8 rounded-full bg-white/90 border border-[#dedede] hover:border-black flex items-center justify-center text-[#111111] transition-all shadow-sm"
                data-wishlist-id="{{ product.id }}"
                onclick="event.stopPropagation(); window.toggleWishlist('{{ product.id }}')"
                aria-label="Add to Wishlist"
              >
                <svg class="w-4 h-4 wishlist-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                </svg>
              </button>

              <img 
                src="{% if img_1 %}{{ img_1 | image_url: width: 800 }}{% else %}{{ '70.png' | asset_url }}{% endif %}" 
                alt="{{ product.title | escape }}" 
                class="img-primary-view absolute inset-0 w-full h-full object-contain p-2 transition-transform duration-300 hover:scale-105" 
              />
              <img 
                src="{% if img_2 %}{{ img_2 | image_url: width: 800 }}{% else %}{{ '74.png' | asset_url }}{% endif %}" 
                alt="{{ product.title | escape }} Alternate" 
                class="img-hover-view absolute inset-0 w-full h-full object-contain p-2 transition-transform duration-300 hover:scale-105" 
              />
            </div>
            <div class="pt-4 flex justify-between items-start border-t border-[#f0f0f0] mt-2 gap-2">
              <div>
                <h3 class="text-sm font-black uppercase tracking-tight text-[#111111] leading-snug">{{ product.title }}</h3>
                {% if product.vendor and product.vendor != product.title %}
                  <p class="text-xs font-semibold uppercase text-[#777777] mt-0.5">{{ product.vendor }}</p>
                {% endif %}
              </div>
              <span class="text-sm font-black text-[#111111] whitespace-nowrap">{{ product.price | money }}</span>
            </div>
          </div>
        {% endfor %}

      {% else %}

        <!-- Fallback Cards if store has no products yet -->
        <div class="shoe-card-item product-grid-item flex flex-col justify-between p-6 bg-white rounded-2xl border border-[#dedede] cursor-pointer" data-product-id="1" data-category="sneakers" onclick="window.showProductDetail('1')">
          <div class="relative w-full aspect-[4/3] flex items-center justify-center p-4 overflow-hidden">
            <img src="{{ '70.png' | asset_url }}" alt="Gucci Sneakers" class="img-primary-view absolute inset-0 w-full h-full object-contain p-2" />
            <img src="{{ '74.png' | asset_url }}" alt="Gucci Sneakers Alternate" class="img-hover-view absolute inset-0 w-full h-full object-contain p-2" />
          </div>
          <div class="pt-4 flex justify-between items-baseline border-t border-[#f0f0f0] mt-2">
            <div>
              <h3 class="text-sm font-black uppercase tracking-tight text-[#111111]">GUCCI</h3>
              <p class="text-xs font-medium text-[#777777]">Crystals Flashtrek Sneakers</p>
            </div>
            <span class="text-sm font-black text-[#111111]">$1,590</span>
          </div>
        </div>

        <div class="shoe-card-item product-grid-item flex flex-col justify-between p-6 bg-white rounded-2xl border border-[#dedede] cursor-pointer" data-product-id="2" data-category="loafers" onclick="window.showProductDetail('2')">
          <div class="relative w-full aspect-[4/3] flex items-center justify-center p-4 overflow-hidden">
            <img src="{{ '71.png' | asset_url }}" alt="Balenciaga Loafers" class="img-primary-view absolute inset-0 w-full h-full object-contain p-2" />
            <img src="{{ '73.png' | asset_url }}" alt="Balenciaga Loafers Alternate" class="img-hover-view absolute inset-0 w-full h-full object-contain p-2" />
          </div>
          <div class="pt-4 flex justify-between items-baseline border-t border-[#f0f0f0] mt-2">
            <div>
              <h3 class="text-sm font-black uppercase tracking-tight text-[#111111]">BALENCIAGA</h3>
              <p class="text-xs font-medium text-[#777777]">Chunky Lug Suede Loafers</p>
            </div>
            <span class="text-sm font-black text-[#111111]">$975</span>
          </div>
        </div>

        <div class="shoe-card-item product-grid-item flex flex-col justify-between p-6 bg-white rounded-2xl border border-[#dedede] cursor-pointer" data-product-id="3" data-category="sneakers" onclick="window.showProductDetail('3')">
          <div class="relative w-full aspect-[4/3] flex items-center justify-center p-4 overflow-hidden">
            <img src="{{ '72.png' | asset_url }}" alt="Palm Angels Sneakers" class="img-primary-view absolute inset-0 w-full h-full object-contain p-2" />
            <img src="{{ '70.png' | asset_url }}" alt="Palm Angels Sneakers Alternate" class="img-hover-view absolute inset-0 w-full h-full object-contain p-2" />
          </div>
          <div class="pt-4 flex justify-between items-baseline border-t border-[#f0f0f0] mt-2">
            <div>
              <h3 class="text-sm font-black uppercase tracking-tight text-[#111111]">PALM ANGELS</h3>
              <p class="text-xs font-medium text-[#777777]">Calfskin Minimalist Low Sneakers</p>
            </div>
            <span class="text-sm font-black text-[#111111]">$395</span>
          </div>
        </div>

      {% endif %}

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Footwear Collection Grid",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Footwear Collection"
    }
  ],
  "presets": [
    {
      "name": "Footwear Collection Grid"
    }
  ]
}
{% endschema %}
