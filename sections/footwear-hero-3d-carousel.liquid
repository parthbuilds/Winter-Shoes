{% comment %}
  Section: Footwear Hero 3D Carousel & Responsive Detail View
  - Mobile: Categories in Slide-out Drawer, 100% Height Centered Carousel
  - Desktop: Collections Sidebar on left margin, 3D Depth Floating Carousel, Sticky Details Frame
{% endcomment %}

{% assign selected_collection = collections[section.settings.collection] %}
{% if selected_collection == blank or selected_collection.products_count == 0 %}
  {% assign selected_collection = collections['shoes'] %}
{% endif %}
{% if selected_collection == blank or selected_collection.products_count == 0 %}
  {% assign selected_collection = collections['winter-shoes'] %}
{% endif %}
{% if selected_collection == blank or selected_collection.products_count == 0 %}
  {% assign selected_collection = collections.all %}
{% endif %}

<!-- Embedded High-Speed Footwear Data Island with Dynamic Shopify Products & Variants -->
<script id="footwear-collection-data" type="application/json">
[
  {% if selected_collection != blank and selected_collection.products_count > 0 %}
    {% for product in selected_collection.products %}
      {% assign formatted_price = product.price | money %}
      {% assign product_subtitle = product.title | append: ' | ' | append: formatted_price %}
      {
        "id": {{ product.id | json }},
        "title": {{ product.title | json }},
        "brand": {{ product.vendor | default: shop.name | json }},
        "category": {{ product.type | default: 'sneakers' | downcase | json }},
        "price": {{ product.price | json }},
        "price_formatted": {{ formatted_price | json }},
        "subtitle": {{ product_subtitle | json }},
        "image_primary": {% if product.featured_image %}{{ product.featured_image | image_url: width: 1200 | json }}{% else %}"{{ '70.png' | asset_url }}"{% endif %},
        "image_secondary": {% if product.images.size > 1 %}{{ product.images[1] | image_url: width: 1200 | json }}{% elsif product.featured_image %}{{ product.featured_image | image_url: width: 1200 | json }}{% else %}"{{ '74.png' | asset_url }}"{% endif %},
        "gallery": [
          {% if product.featured_image %}{{ product.featured_image | image_url: width: 1200 | json }}{% else %}"{{ '70.png' | asset_url }}"{% endif %}
          {% if product.images.size > 1 %}, {{ product.images[1] | image_url: width: 1200 | json }}{% endif %}
        ],
        "description": {{ product.description | strip_html | truncatewords: 40 | default: 'Handcrafted luxury footwear designed with premium materials.' | json }},
        "details": "• Upper: Premium Leather & Suede\n• Sole: Molded vulcanized rubber\n• Heel: Reinforced heel cup\n• Origin: Crafted with care in Italy",
        "delivery": "• Express international shipping via DHL\n• Free delivery on orders over $150\n• Complimentary 30-day returns with prepaid shipping label",
        "material": "Upper: Premium Leather / Suede. Sole: Molded Rubber.",
        "collections": [{% for c in product.collections %}{{ c.handle | json }}{% unless forloop.last %},{% endunless %}{% endfor %}],
        "variants": [
          {% for v in product.variants %}
            {% assign v_price = v.price | money %}
            {
              "id": {{ v.id | json }},
              "title": {{ v.title | json }},
              "price": {{ v_price | json }}
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ]
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  {% else %}
    {
      "id": "1",
      "brand": "GUCCI",
      "title": "Crystals Flashtrek Sneakers",
      "subtitle": "Crystals Flashtrek Sneakers | $1,590",
      "category": "sneakers",
      "price": 159000,
      "price_formatted": "$1,590",
      "material": "Technical knit, suede & sculpted responsive sole",
      "description": "Low-top panelled mesh and technical canvas sneakers in navy and off-white. Ergonomic cushioned footbed with responsive shock-absorbing midsole.",
      "image_primary": "{{ '70.png' | asset_url }}",
      "image_secondary": "{{ '74.png' | asset_url }}",
      "gallery": ["{{ '70.png' | asset_url }}", "{{ '74.png' | asset_url }}"],
      "collections": ["all"],
      "variants": [
        {"id": "v1", "title": "Size 39", "price": "$1,590"},
        {"id": "v2", "title": "Size 40", "price": "$1,590"},
        {"id": "v3", "title": "Size 41", "price": "$1,590"},
        {"id": "v4", "title": "Size 42", "price": "$1,590"}
      ]
    },
    {
      "id": "2",
      "brand": "BALENCIAGA",
      "title": "Chunky Lug Suede Loafers",
      "subtitle": "Chunky Lug Suede Loafers | $975",
      "category": "loafers",
      "price": 97500,
      "price_formatted": "$975",
      "material": "Oiled Tuscan suede with sculpted tread sole",
      "description": "Handcrafted low-top derbies in wheat tan suede. Heavy-duty lug sole with stacked block heel.",
      "image_primary": "{{ '71.png' | asset_url }}",
      "image_secondary": "{{ '73.png' | asset_url }}",
      "gallery": ["{{ '71.png' | asset_url }}", "{{ '73.png' | asset_url }}"],
      "collections": ["all"],
      "variants": [
        {"id": "v5", "title": "Size 40", "price": "$975"},
        {"id": "v6", "title": "Size 41", "price": "$975"}
      ]
    }
  {% endif %}
]
</script>

<section 
  id="hero-carousel-section"
  class="relative w-full min-h-[88vh] bg-[#ededed] text-[#111111] flex flex-col justify-between py-4 md:py-6 px-4 md:px-12 transition-all duration-500"
  data-section-id="{{ section.id }}"
  data-section-type="footwear-hero-carousel"
>

  <!-- DESKTOP LEFT SIDEBAR: Dynamic Collections List from Store -->
  <div id="hero-left-sidebar" class="hidden lg:block lg:absolute lg:left-10 lg:top-8 z-30 space-y-6 pt-2 transition-all duration-500">
    
    <!-- Search Input -->
    <div class="relative max-w-[180px]">
      <span class="absolute inset-y-0 left-0 flex items-center pointer-events-none text-xs text-[#888888]">
        ⌕
      </span>
      <input 
        type="text" 
        id="hero-search-input"
        placeholder="RECHERCHER" 
        class="w-full pl-5 pr-2 py-1 bg-transparent text-xs font-sans tracking-widest uppercase text-[#111111] placeholder-[#888888] border-b border-[#cccccc] focus:border-[#111111] focus:outline-none transition-colors"
      />
    </div>

    <!-- Dynamic Collections List from Shopify Store -->
    <div class="pt-1">
      <a href="#all" data-filter-collection="all" class="block text-2xl md:text-3xl font-black tracking-tight text-[#111111] uppercase font-sans">
        COLLECTIONS
      </a>

      <!-- Subcategories / Collections -->
      <div class="pl-2.5 mt-2.5 space-y-1 text-xs font-semibold text-[#666666]">
        <a href="#all" data-filter-collection="all" class="sidebar-subcat block py-0.5 text-[#111111] font-bold">
          <span class="underline">All Footwear</span>
        </a>
        {% for col in collections %}
          {% unless col.handle == 'frontpage' %}
            <a href="{{ col.url }}" data-filter-collection="{{ col.handle }}" class="sidebar-subcat block py-0.5 text-[#777777] hover:text-[#111111] transition-colors">
              {{ col.title }}
            </a>
          {% endunless %}
        {% endfor %}
      </div>
    </div>
  </div>

  <!-- CENTER STAGE & META: 100% Full-Width Centered Under Logo -->
  <div id="hero-right-stage" class="w-full flex-1 flex flex-col items-center justify-between my-auto relative z-20">
    
    <!-- 3-Shoe Floating Stage -->
    <div id="hero-carousel-stage" class="carousel-stage-container w-full">
      
      <!-- Left Navigation Arrow Button -->
      <button 
        id="btn-carousel-prev"
        type="button"
        class="carousel-arrow-btn absolute left-2 md:left-12 lg:left-24 z-30"
        aria-label="Previous Shoe"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/>
        </svg>
      </button>

      <!-- Left Sibling Shoe -->
      <div id="floating-shoe-left" class="floating-shoe-slot pos-left max-w-[280px] sm:max-w-[340px] md:max-w-[420px] w-full aspect-[4/3]">
        <div class="shoe-shadow-disc"></div>
        <img id="img-shoe-left" src="{{ '75.png' | asset_url }}" alt="Previous shoe" class="w-full h-full object-contain drop-shadow-xl pointer-events-none" />
      </div>

      <!-- Center Main Floating Shoe -->
      <div id="floating-shoe-center" class="floating-shoe-slot pos-center max-w-[360px] sm:max-w-[460px] md:max-w-[620px] w-full aspect-[4/3]">
        <div class="shoe-shadow-disc"></div>
        <img id="img-shoe-center" src="{{ '70.png' | asset_url }}" alt="Active shoe" class="w-full h-full object-contain drop-shadow-2xl" />
      </div>

      <!-- Right Sibling Shoe -->
      <div id="floating-shoe-right" class="floating-shoe-slot pos-right max-w-[280px] sm:max-w-[340px] md:max-w-[420px] w-full aspect-[4/3]">
        <div class="shoe-shadow-disc"></div>
        <img id="img-shoe-right" src="{{ '71.png' | asset_url }}" alt="Next shoe" class="w-full h-full object-contain drop-shadow-xl pointer-events-none" />
      </div>

      <!-- Right Navigation Arrow Button -->
      <button 
        id="btn-carousel-next"
        type="button"
        class="carousel-arrow-btn absolute right-2 md:right-12 lg:right-24 z-30"
        aria-label="Next Shoe"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
        </svg>
      </button>

    </div>

    <!-- State A: Centered Brand Name & SEE MORE Button -->
    <div id="hero-carousel-meta" class="text-center space-y-1.5 -mt-2 pb-6 z-20 transition-all duration-400 w-full flex flex-col items-center justify-center">
      <h1 id="carousel-brand-heading" class="text-3xl md:text-5xl font-black tracking-tight text-[#111111] uppercase font-sans">
        GUCCI
      </h1>

      <p id="carousel-product-subtitle" class="text-xs md:text-sm font-semibold text-[#666666] tracking-wide">
        Crystals Flashtrek Sneakers | $1,590
      </p>

      <div class="pt-2 flex justify-center w-full">
        <button 
          id="carousel-see-more-action"
          type="button" 
          class="btn-pill-see-more"
        >
          SEE MORE
        </button>
      </div>
    </div>

    <!-- State B: In-Place Selected Product Detail HUD -->
    <div id="in-place-detail-hud" class="w-full max-w-[1680px] mx-auto hidden opacity-0 grid grid-cols-1 md:grid-cols-12 gap-6 items-end pt-6 pb-4 border-t border-[#dedede]/80 transition-all duration-500 z-30">
      <!-- Left Corner: Brand Title + Subtitle -->
      <div class="md:col-span-7 space-y-1">
        <div class="flex items-baseline gap-3 flex-wrap">
          <h2 id="hud-brand-title" class="text-3xl md:text-5xl font-black tracking-tight text-[#111111] uppercase font-sans">
            GUCCI
          </h2>
          <span class="text-3xl md:text-5xl font-black text-outline-brand">
            SHOES
          </span>
        </div>
        <p id="hud-shoe-subtitle" class="text-xs md:text-sm font-semibold text-[#777777]">
          Crystals Flashtrek Sneakers | $1,590
        </p>
      </div>

      <!-- Right Corner: Color dots, Dynamic Variant Dropdown, Price, Add to Cart -->
      <div class="md:col-span-5 flex flex-col items-start md:items-end space-y-4">
        <div class="flex items-center gap-4 sm:gap-6 flex-wrap">
          <!-- Colorway dots -->
          <div class="flex items-center space-x-2">
            <button class="w-5 h-5 rounded-full bg-[#111111] border-2 border-white ring-1 ring-black/20 cursor-pointer" title="Black"></button>
            <button class="w-5 h-5 rounded-full bg-[#ffffff] border-2 border-gray-300 ring-1 ring-black/20 cursor-pointer" title="White"></button>
          </div>

          <!-- Dynamic Variant Selector -->
          <div class="relative">
            <select 
              id="hud-size-dropdown"
              class="appearance-none bg-white border border-[#cccccc] hover:border-[#111111] text-[#111111] text-xs font-bold py-2.5 pl-4 pr-8 rounded-lg cursor-pointer focus:outline-none transition-colors"
            >
              <option value="default">Select Variant ▾</option>
            </select>
            <span class="absolute right-2.5 top-1/2 -translate-y-1/2 pointer-events-none text-xs text-[#555555]">
              ▾
            </span>
          </div>

          <!-- Large Bold Price (Native Store Currency Format, Clean without trailing $) -->
          <div id="hud-shoe-price" class="text-2xl sm:text-3xl md:text-4xl font-black text-[#111111] tracking-tight">
            $1,590
          </div>
        </div>

        <!-- Add to Cart Action Row -->
        <div class="flex items-center gap-3 w-full md:w-auto">
          <button 
            id="hud-add-cart-action"
            type="button" 
            class="btn-pill-add-cart flex-1 md:flex-initial"
          >
            <span>ADD TO CART</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
            </svg>
          </button>

          <button 
            id="hud-wishlist-action"
            type="button" 
            class="w-11 h-11 rounded-full border border-[#cccccc] bg-white hover:border-[#111111] flex items-center justify-center text-[#111111] transition-colors cursor-pointer shadow-sm"
            aria-label="Wishlist"
          >
            <svg class="w-4 h-4 wishlist-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
            </svg>
          </button>
        </div>
      </div>
    </div>

  </div>

  <!-- State C: Tall Vertical 3:4 Cards on Left + Sticky Details on Right -->
  <div id="in-place-scroll-gallery" class="max-w-[1680px] mx-auto w-full hidden opacity-0 flex flex-col lg:flex-row gap-12 pt-8 md:pt-16 pb-32 relative">
    
    <!-- MOBILE VIEW DETAILS CONTAINER -->
    <div class="lg:hidden w-full space-y-6">
      <p id="mobile-gallery-description" class="text-sm text-[#222222] leading-relaxed font-normal">
        Handcrafted luxury footwear designed with premium materials. Ergonomic cushioned footbed with responsive shock-absorbing midsole.
      </p>

      <!-- Mobile Accordions -->
      <div class="border-t border-[#dedede] pt-3 space-y-3">
        <div class="border-b border-[#dedede] pb-3">
          <button type="button" class="ssense-acc-toggle w-full flex justify-between items-center text-sm font-bold text-[#111111] py-1 cursor-pointer">
            <span>Details</span>
            <span class="acc-chevron text-xs text-[#888888]">⌵</span>
          </button>
          <div id="mobile-gallery-details" class="ssense-acc-panel text-xs text-[#555555] space-y-1.5 mt-2">
            <p>• Upper: Suede, Leather & Technical Canvas.</p>
            <p>• Sole: Molded vulcanized rubber.</p>
            <p>• Padded low-cut collar with reinforced heel cup.</p>
            <p>• Premium Quality Atelier Standard.</p>
          </div>
        </div>

        <div class="border-b border-[#dedede] pb-3">
          <button type="button" class="ssense-acc-toggle w-full flex justify-between items-center text-sm font-bold text-[#111111] py-1 cursor-pointer">
            <span>Free Delivery and Returns</span>
            <span class="acc-chevron text-xs text-[#888888]">⌵</span>
          </button>
          <div id="mobile-gallery-delivery" class="ssense-acc-panel hidden text-xs text-[#555555] space-y-1.5 mt-2">
            <p>• Express international delivery by DHL.</p>
            <p>• Complimentary 30-day returns with prepaid shipping label.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- LEFT COLUMN: Tall Studio Photo Cards -->
    <div class="w-full lg:w-7/12 space-y-8 md:space-y-12">
      <div class="tall-studio-card">
        <img 
          id="gallery-photo-front"
          src="{{ '70.png' | asset_url }}" 
          alt="Studio perspective primary" 
          class="max-h-[320px] md:max-h-[560px] w-auto max-w-[92%] object-contain drop-shadow-2xl"
        />
      </div>

      <div class="tall-studio-card">
        <img 
          id="gallery-photo-heel"
          src="{{ '74.png' | asset_url }}" 
          alt="Studio perspective secondary" 
          class="max-h-[320px] md:max-h-[560px] w-auto max-w-[92%] object-contain drop-shadow-2xl"
        />
      </div>
    </div>

    <!-- DESKTOP RIGHT COLUMN: Sticky Details Panel -->
    <div class="hidden lg:block lg:w-5/12">
      <div class="sticky-details-container space-y-8 bg-[#ededed] py-2">
        <div class="space-y-4">
          <p id="gallery-full-description" class="text-base md:text-lg text-[#222222] leading-relaxed font-normal">
            Handcrafted luxury footwear designed with premium materials. Ergonomic cushioned footbed with responsive shock-absorbing midsole.
          </p>
        </div>

        <!-- Accordions -->
        <div class="border-t border-[#dedede] pt-4 space-y-4">
          <div class="border-b border-[#dedede] pb-4">
            <button type="button" class="ssense-acc-toggle w-full flex justify-between items-center text-base font-bold text-[#111111] py-1 cursor-pointer">
              <span>Details</span>
              <span class="acc-chevron text-xs text-[#888888]">⌵</span>
            </button>
            <div id="gallery-full-details" class="ssense-acc-panel text-sm text-[#555555] space-y-2 mt-3">
              <p>• Upper: Suede, Leather & Technical Canvas.</p>
              <p>• Sole: Molded vulcanized rubber.</p>
              <p>• Padded low-cut collar with reinforced heel cup.</p>
              <p>• Premium Quality Atelier Standard.</p>
            </div>
          </div>

          <div class="border-b border-[#dedede] pb-4">
            <button type="button" class="ssense-acc-toggle w-full flex justify-between items-center text-base font-bold text-[#111111] py-1 cursor-pointer">
              <span>Free Delivery and Returns</span>
              <span class="acc-chevron text-xs text-[#888888]">⌵</span>
            </button>
            <div id="gallery-full-delivery" class="ssense-acc-panel hidden text-sm text-[#555555] space-y-2 mt-3">
              <p>• Express international delivery by DHL.</p>
              <p>• Complimentary 30-day returns with prepaid shipping label.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Footwear Hero Carousel",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Footwear Collection"
    }
  ],
  "presets": [
    {
      "name": "Footwear Hero Carousel"
    }
  ]
}
{% endschema %}
