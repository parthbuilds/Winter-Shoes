{% comment %}
  Section: Header & Navigation Bar
  Fully customizable in Shopify Theme Customizer
{% endcomment %}

<header class="ssense-header-sticky w-full px-4 md:px-12 py-5 md:py-6 relative flex items-center justify-between">
  
  <!-- Left: Mobile Hamburger / Back Button / Desktop Nav Links -->
  <div class="flex items-center space-x-3 md:space-x-8 z-20">
    <!-- Back Button (Shown in detail/grid mode) -->
    <button 
      id="global-back-btn" 
      type="button" 
      class="hidden items-center gap-1.5 text-xs font-bold tracking-widest text-[#111111] hover:opacity-60 transition-opacity uppercase cursor-pointer"
    >
      <span class="text-sm font-black">←</span>
      <span>BACK</span>
    </button>

    <!-- Mobile Hamburger Button (Only on Mobile/Tablet) -->
    <button 
      id="mobile-menu-toggle-btn"
      type="button" 
      class="lg:hidden flex items-center justify-center w-9 h-9 rounded-lg text-[#111111] hover:bg-black/5 transition-colors cursor-pointer"
      aria-label="Toggle Category Menu"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>

    <!-- Desktop Navigation Links (Default: HOME & CONTACT - catalog removed) -->
    <nav class="hidden md:flex items-center space-x-7 text-xs font-sans tracking-widest uppercase">
      {% if section.settings.menu != blank %}
        {% for link in linklists[section.settings.menu].links %}
          {% assign link_title_clean = link.title | downcase %}
          {% unless link_title_clean == 'catalog' %}
            <a 
              href="{{ link.url }}" 
              class="pb-0.5 {% if link.active or forloop.first %}font-extrabold text-[#111111] border-b-2 border-black{% else %}font-semibold text-[#777777] hover:text-[#111111] transition-colors{% endif %}"
            >
              {{ link.title }}
            </a>
          {% endunless %}
        {% endfor %}
      {% else %}
        <a href="/" class="font-extrabold text-[#111111] border-b-2 border-black pb-0.5">HOME</a>
        <a href="/contact" class="font-semibold text-[#777777] hover:text-[#111111] transition-colors pb-0.5">CONTACT</a>
      {% endif %}
    </nav>
  </div>

  <!-- Center: Logo (Supports custom uploaded image or text logo) -->
  <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 z-10 flex items-center justify-center pointer-events-none">
    <a href="/" class="pointer-events-auto inline-flex items-center justify-center hover:opacity-85 transition-opacity">
      {% if section.settings.logo != blank %}
        <img 
          src="{{ section.settings.logo | image_url: width: 500 }}" 
          alt="{{ section.settings.logo_text | default: shop.name | escape }}" 
          class="h-8 sm:h-10 md:h-12 w-auto object-contain max-w-[200px] md:max-w-[240px]"
        />
      {% elsif section.settings.logo_svg_text != blank %}
        <span class="text-xl md:text-2xl font-black tracking-widest uppercase text-[#111111]">
          {{ section.settings.logo_svg_text }}
        </span>
      {% else %}
        <img 
          src="{{ 'logo.svg' | asset_url }}" 
          alt="{{ shop.name | escape }}" 
          class="h-8 sm:h-10 md:h-12 w-auto object-contain max-w-[200px] md:max-w-[240px]" 
          onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
        />
        <span class="text-xl md:text-2xl font-black tracking-widest uppercase text-[#111111]" style="display:none;">
          {{ shop.name | default: 'WINTER SHOES' }}
        </span>
      {% endif %}
    </a>
  </div>

  <!-- Right: Wishlist, Blog, Search, Bag, Language & View Switcher -->
  <div class="flex items-center justify-end space-x-3 md:space-x-5 text-xs font-sans tracking-widest uppercase z-20">
    <a href="/wishlist" class="relative font-semibold text-[#777777] hover:text-[#111111] transition-colors flex items-center gap-1">
      <span>WISHLIST</span>
      <span id="nav-wishlist-badge" class="hidden bg-[#111111] text-white text-[9px] w-3.5 h-3.5 rounded-full flex items-center justify-center font-sans font-bold">
        0
      </span>
    </a>
    
    <!-- Search icon -->
    <button type="button" class="text-[#111111] hover:opacity-60 transition-opacity p-1" aria-label="Search">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
      </svg>
    </button>

    <!-- Shopping Bag Link -> Goes to /cart -->
    <a href="/cart" class="relative text-[#111111] hover:opacity-60 transition-opacity p-1" aria-label="Shopping Bag">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
      </svg>
      <span id="nav-cart-badge" class="{% if cart.item_count == 0 %}hidden{% endif %} absolute -top-1 -right-1 bg-[#111111] text-white text-[9px] w-3.5 h-3.5 rounded-full flex items-center justify-center font-sans font-bold">
        {{ cart.item_count }}
      </span>
    </a>

    <!-- View Switcher Group -->
    <div class="view-switcher-group pl-1 md:pl-3 border-l border-[#dedede]">
      <button 
        id="top-view-grid-btn"
        type="button" 
        class="view-btn"
        title="Grid View"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <rect x="3" y="3" width="7" height="7" stroke-width="2"/>
          <rect x="14" y="3" width="7" height="7" stroke-width="2"/>
          <rect x="3" y="14" width="7" height="7" stroke-width="2"/>
          <rect x="14" y="14" width="7" height="7" stroke-width="2"/>
        </svg>
      </button>

      <button 
        id="top-view-carousel-btn"
        type="button" 
        class="view-btn active"
        title="3D Depth Carousel View"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <rect x="3" y="5" width="18" height="14" rx="2" stroke-width="2"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5v14M15 5v14"/>
        </svg>
      </button>
    </div>
  </div>

</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "text",
      "id": "logo_svg_text",
      "label": "Brand Title Text (Fallback)",
      "default": "WINTER SHOES"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show Wishlist Link",
      "default": true
    }
  ]
}
{% endschema %}
