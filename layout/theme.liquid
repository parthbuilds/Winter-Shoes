<!DOCTYPE html>
<html lang="{{ request.locale.iso_code | default: 'en' }}" class="scroll-smooth">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>{{ page_title | default: 'SSENSE | Luxury Footwear' }}</title>
  <meta name="description" content="{{ page_description | default: 'SSENSE Luxury Footwear - Curated Designer Shoes, Sneakers, Loafers and Boots.' | escape }}">

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            mono: ['Inter', 'monospace']
          },
          colors: {
            'ssense-bg': '#ededed',
            'ssense-black': '#111111',
            'ssense-gray': '#777777',
            'ssense-border': '#dedede'
          }
        }
      }
    }
  </script>

  <!-- GSAP & Plugins CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>

  <!-- Theme Stylesheet -->
  <link rel="stylesheet" href="{{ 'footwear-theme.css' | asset_url }}">
  {{ content_for_header }}
</head>
<body class="bg-[#ededed] text-[#111111] antialiased min-h-screen flex flex-col justify-between selection:bg-black selection:text-white">

  <!-- SSENSE Top Sticky Spacious Navigation Bar -->
  <header class="ssense-header-sticky w-full px-4 md:px-12 py-5 md:py-6 relative flex items-center justify-between">
    
    <!-- Left: Mobile Hamburger / Back Button / Desktop Nav Links -->
    <div class="flex items-center space-x-3 md:space-x-8 z-20">
      <!-- Back Button (Shown in detail/grid mode) -->
      <button 
        id="global-back-btn" 
        type="button" 
        class="hidden items-center gap-1.5 text-xs font-bold tracking-widest text-[#111111] hover:opacity-60 transition-opacity uppercase cursor-pointer"
      >
        <span class="text-sm font-black">←</span>
        <span>BACK</span>
      </button>

      <!-- Mobile Hamburger Button (Only on Mobile/Tablet) -->
      <button 
        id="mobile-menu-toggle-btn"
        type="button" 
        class="lg:hidden flex items-center justify-center w-9 h-9 rounded-lg text-[#111111] hover:bg-black/5 transition-colors cursor-pointer"
        aria-label="Toggle Category Menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>

      <!-- Desktop Category Switcher (MEN / WOMAN) with Bold Underline -->
      <nav class="hidden md:flex items-center space-x-7 text-xs font-sans tracking-widest uppercase">
        <a href="#men" class="font-extrabold text-[#111111] border-b-2 border-black pb-0.5">MEN</a>
        <a href="#woman" class="font-semibold text-[#777777] hover:text-[#111111] transition-colors pb-0.5">WOMAN</a>
      </nav>
    </div>

    <!-- Center: Logo SVG (Mathematically 100% Dead-Center in Viewport) -->
    <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 z-10 flex items-center justify-center pointer-events-none">
      <a href="/" class="pointer-events-auto inline-flex items-center justify-center hover:opacity-85 transition-opacity">
        <img 
          src="{{ 'logo.svg' | asset_url }}" 
          alt="SSENSE Luxury" 
          class="h-8 sm:h-10 md:h-12 w-auto object-contain max-w-[200px] md:max-w-[240px]" 
        />
      </a>
    </div>

    <!-- Right: Wishlist, Blog, Search, Bag, Language & View Switcher -->
    <div class="flex items-center justify-end space-x-3 md:space-x-5 text-xs font-sans tracking-widest uppercase z-20">
      <a href="#wishlist" class="hidden lg:inline font-semibold text-[#777777] hover:text-[#111111] transition-colors">WISHLIST</a>
      <a href="#blog" class="hidden lg:inline font-semibold text-[#777777] hover:text-[#111111] transition-colors">BLOG</a>
      
      <!-- Search icon -->
      <button type="button" class="text-[#111111] hover:opacity-60 transition-opacity p-1" aria-label="Search">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
      </button>

      <!-- Shopping Bag -->
      <a href="#cart" class="relative text-[#111111] hover:opacity-60 transition-opacity p-1" aria-label="Shopping Bag">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
        </svg>
        <span id="nav-cart-badge" class="hidden absolute -top-1 -right-1 bg-[#111111] text-white text-[9px] w-3.5 h-3.5 rounded-full flex items-center justify-center font-sans font-bold">
          0
        </span>
      </a>

      <!-- Language Switcher -->
      <span class="hidden sm:inline text-xs font-semibold text-[#777777] cursor-pointer hover:text-[#111111]">
        En▾
      </span>

      <!-- Sticky Header View Switcher (Grid / Carousel) -->
      <div class="view-switcher-group pl-1 md:pl-3 border-l border-[#dedede]">
        <button 
          id="top-view-grid-btn"
          type="button" 
          class="view-btn"
          title="Grid View"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <rect x="3" y="3" width="7" height="7" stroke-width="2"/>
            <rect x="14" y="3" width="7" height="7" stroke-width="2"/>
            <rect x="3" y="14" width="7" height="7" stroke-width="2"/>
            <rect x="14" y="14" width="7" height="7" stroke-width="2"/>
          </svg>
        </button>

        <button 
          id="top-view-carousel-btn"
          type="button" 
          class="view-btn active"
          title="3D Depth Carousel View"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <rect x="3" y="5" width="18" height="14" rx="2" stroke-width="2"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5v14M15 5v14"/>
          </svg>
        </button>
      </div>
    </div>

  </header>

  <!-- Mobile Sliding Drawer Navigation (z-100 on top of everything) -->
  <div 
    id="mobile-drawer-overlay"
    class="fixed inset-0 bg-black/50 backdrop-blur-sm z-[90] hidden opacity-0 transition-opacity duration-300"
  ></div>

  <aside 
    id="mobile-drawer"
    class="fixed top-0 left-0 bottom-0 w-4/5 max-w-[320px] bg-[#ededed] z-[100] p-6 flex flex-col justify-between transform -translate-x-full transition-transform duration-300 ease-out shadow-2xl border-r border-[#dedede]"
  >
    <div class="space-y-6">
      <div class="flex items-center justify-between pb-4 border-b border-[#dedede]">
        <span class="text-xs font-sans font-black tracking-widest uppercase">CATEGORIES</span>
        <button id="mobile-drawer-close-btn" class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold bg-white border border-[#dedede] shadow-sm hover:bg-black hover:text-white transition-colors">✕</button>
      </div>

      <!-- Search inside Drawer -->
      <div class="relative w-full">
        <span class="absolute inset-y-0 left-0 flex items-center pointer-events-none text-xs text-[#888888]">⌕</span>
        <input 
          type="text" 
          id="mobile-drawer-search"
          placeholder="RECHERCHER" 
          class="w-full pl-5 pr-2 py-1.5 bg-transparent text-xs font-sans tracking-widest uppercase text-[#111111] placeholder-[#888888] border-b border-[#cccccc] focus:border-[#111111] focus:outline-none"
        />
      </div>

      <!-- SHOES Categories in Mobile Drawer -->
      <div class="pt-2">
        <a href="#shoes" data-filter-category="all" class="block text-2xl font-black tracking-tight text-[#111111] uppercase font-sans">
          SHOES
        </a>

        <div class="pl-3 mt-3 space-y-2 text-xs font-semibold text-[#666666]">
          <a href="#sneakers" data-filter-category="sneakers" class="sidebar-subcat block py-1 text-[#111111] font-bold">
            <span class="underline">Sneakers</span>
          </a>
          <a href="#sandals" data-filter-category="sandals" class="sidebar-subcat block py-1 text-[#777777] hover:text-[#111111]">
            Sandals
          </a>
          <a href="#loafers" data-filter-category="loafers" class="sidebar-subcat block py-1 text-[#777777] hover:text-[#111111]">
            Loafers
          </a>
          <a href="#boots" data-filter-category="boots" class="sidebar-subcat block py-1 text-[#777777] hover:text-[#111111]">
            Boots
          </a>
          <a href="#espadrilles" data-filter-category="espadrilles" class="sidebar-subcat block py-1 text-[#777777] hover:text-[#111111]">
            Espadrilles
          </a>
          <a href="#monkstraps" data-filter-category="monkstraps" class="sidebar-subcat block py-1 text-[#777777] hover:text-[#111111]">
            Monkstraps
          </a>
        </div>
      </div>
    </div>

    <!-- Mobile Drawer Footer -->
    <div class="pt-6 border-t border-[#dedede] flex justify-between text-xs font-sans font-bold text-[#777777]">
      <a href="#men" class="text-[#111111]">MEN</a>
      <a href="#woman">WOMAN</a>
      <a href="#wishlist">WISHLIST</a>
    </div>
  </aside>

  <!-- Main Content Layout -->
  <main id="MainContent" class="flex-grow w-full">
    {{ content_for_layout }}
  </main>

  <!-- Footer -->
  <footer class="w-full bg-[#ededed] border-t border-[#dedede]/60 py-6 px-6 md:px-12 text-[11px] font-sans text-[#888888] flex flex-col md:flex-row justify-between items-center gap-4">
    <div>
      © {{ 'now' | date: '%Y' }} SSENSE — LUXURY FOOTWEAR ATELIER.
    </div>
    <div class="flex space-x-6">
      <a href="#terms" class="hover:text-[#111111]">TERMS</a>
      <a href="#privacy" class="hover:text-[#111111]">PRIVACY</a>
      <a href="#cookies" class="hover:text-[#111111]">COOKIES</a>
    </div>
  </footer>

  <!-- Core JavaScript Interaction Layer -->
  <script src="{{ 'footwear-core.js' | asset_url }}"></script>
</body>
</html>
