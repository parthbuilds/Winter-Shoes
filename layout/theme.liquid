<!DOCTYPE html>
<html lang="{{ request.locale.iso_code | default: 'en' }}" class="scroll-smooth">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>{{ page_title | default: 'SSENSE | Luxury Footwear' }}</title>
  <meta name="description" content="{{ page_description | default: 'SSENSE Luxury Footwear - Curated Designer Shoes, Sneakers, Loafers and Boots.' | escape }}">

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            mono: ['Inter', 'monospace']
          },
          colors: {
            'ssense-bg': '#ededed',
            'ssense-black': '#111111',
            'ssense-gray': '#777777',
            'ssense-border': '#dedede'
          }
        }
      }
    }
  </script>

  <!-- GSAP & Plugins CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>

  <!-- Theme Stylesheet -->
  <link rel="stylesheet" href="{{ 'footwear-theme.css' | asset_url }}">
  {{ content_for_header }}
</head>
<body class="bg-[#ededed] text-[#111111] antialiased min-h-screen flex flex-col justify-between selection:bg-black selection:text-white">

  <!-- SSENSE Top Sticky Spacious Navigation Bar (Editable via Theme Customizer) -->
  {% section 'header' %}

  <!-- Mobile Sliding Drawer Navigation (z-100 on top of everything) -->
  <div 
    id="mobile-drawer-overlay"
    class="fixed inset-0 bg-black/50 backdrop-blur-sm z-[90] hidden opacity-0 transition-opacity duration-300"
  ></div>

  <aside 
    id="mobile-drawer"
    class="fixed top-0 left-0 bottom-0 w-4/5 max-w-[320px] bg-[#ededed] z-[100] p-6 flex flex-col justify-between transform -translate-x-full transition-transform duration-300 ease-out shadow-2xl border-r border-[#dedede]"
  >
    <div class="space-y-6">
      <div class="flex items-center justify-between pb-4 border-b border-[#dedede]">
        <span class="text-xs font-sans font-black tracking-widest uppercase">CATEGORIES</span>
        <button id="mobile-drawer-close-btn" class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold bg-white border border-[#dedede] shadow-sm hover:bg-black hover:text-white transition-colors">✕</button>
      </div>

      <!-- Search inside Drawer -->
      <div class="relative w-full">
        <span class="absolute inset-y-0 left-0 flex items-center pointer-events-none text-xs text-[#888888]">⌕</span>
        <input 
          type="text" 
          id="mobile-drawer-search"
          placeholder="RECHERCHER" 
          class="w-full pl-5 pr-2 py-1.5 bg-transparent text-xs font-sans tracking-widest uppercase text-[#111111] placeholder-[#888888] border-b border-[#cccccc] focus:border-[#111111] focus:outline-none"
        />
      </div>

      <!-- COLLECTIONS in Mobile Drawer -->
      <div class="pt-2">
        <a href="#all" data-filter-collection="all" class="block text-2xl font-black tracking-tight text-[#111111] uppercase font-sans">
          COLLECTIONS
        </a>

        <div class="pl-3 mt-3 space-y-2 text-xs font-semibold text-[#666666]">
          <a href="#all" data-filter-collection="all" class="sidebar-subcat block py-1 text-[#111111] font-bold">
            <span class="underline">All Footwear</span>
          </a>
          <a href="#shoes" data-filter-collection="shoes" data-filter-category="shoes" class="sidebar-subcat block py-1 text-[#777777] hover:text-[#111111]">Shoes</a>
          <a href="#sliders" data-filter-collection="sliders" data-filter-category="sliders" class="sidebar-subcat block py-1 text-[#777777] hover:text-[#111111]">Sliders</a>
          <a href="#sneakers" data-filter-collection="sneakers" data-filter-category="sneakers" class="sidebar-subcat block py-1 text-[#777777] hover:text-[#111111]">Sneakers</a>
          <a href="#loafers" data-filter-collection="loafers" data-filter-category="loafers" class="sidebar-subcat block py-1 text-[#777777] hover:text-[#111111]">Loafers</a>
          <a href="#boots" data-filter-collection="boots" data-filter-category="boots" class="sidebar-subcat block py-1 text-[#777777] hover:text-[#111111]">Boots</a>
          {% for col in collections %}
            {% unless col.handle == 'frontpage' or col.handle == 'shoes' or col.handle == 'sliders' or col.handle == 'sneakers' or col.handle == 'loafers' or col.handle == 'boots' %}
              <a href="{{ col.url }}" data-filter-collection="{{ col.handle }}" class="sidebar-subcat block py-1 text-[#777777] hover:text-[#111111]">
                {{ col.title }}
              </a>
            {% endunless %}
          {% endfor %}
        </div>
      </div>
    </div>

    <!-- Mobile Drawer Footer -->
    <div class="pt-6 border-t border-[#dedede] flex justify-between text-xs font-sans font-bold text-[#777777]">
      <a href="#men" class="text-[#111111]">MEN</a>
      <a href="#woman">WOMAN</a>
      <a href="#wishlist">WISHLIST</a>
    </div>
  </aside>

  <!-- Main Content Layout -->
  <main id="MainContent" class="flex-grow w-full">
    {{ content_for_layout }}
  </main>

  <!-- Footer -->
  <footer class="w-full bg-[#ededed] border-t border-[#dedede]/60 py-6 px-6 md:px-12 text-[11px] font-sans text-[#888888] flex flex-col md:flex-row justify-between items-center gap-4">
    <div>
      © {{ 'now' | date: '%Y' }} SSENSE — LUXURY FOOTWEAR ATELIER.
    </div>
    <div class="flex space-x-6">
      <a href="#terms" class="hover:text-[#111111]">TERMS</a>
      <a href="#privacy" class="hover:text-[#111111]">PRIVACY</a>
      <a href="#cookies" class="hover:text-[#111111]">COOKIES</a>
    </div>
  </footer>

  <!-- Core JavaScript Interaction Layer -->
  <script src="{{ 'footwear-core.js' | asset_url }}"></script>
</body>
</html>
