{% comment %}
  Footwear Card Snippet
  Clean SSENSE-styled card with dual-image hover transition and instant detail view trigger.
{% endcomment %}

{% assign p_category = product.category | default: product.type | default: 'Sneakers' | downcase %}
{% assign img_1 = product.featured_image | default: product.image %}
{% assign img_2 = product.secondary_image | default: product.images[1] | default: img_1 %}

<div 
  class="product-grid-card group flex flex-col justify-between p-6 bg-white border border-[#e8e8e8] rounded-xl cursor-pointer shoe-card-item relative"
  data-category="{{ p_category }}"
  data-product-id="{{ product.id }}"
  onclick="window.showProductDetail('{{ product.id }}')"
>
  <!-- Card Image Showcase with Dual-Image Hover Swap & Wishlist Action -->
  <div class="relative w-full aspect-[4/3] flex items-center justify-center overflow-hidden my-2">
    <!-- Wishlist Heart Button -->
    <button 
      type="button" 
      class="wishlist-btn absolute top-1 right-1 z-20 w-8 h-8 rounded-full bg-white/90 border border-[#dedede] hover:border-black flex items-center justify-center text-[#111111] transition-all shadow-sm"
      data-wishlist-id="{{ product.id }}"
      onclick="event.stopPropagation(); window.toggleWishlist('{{ product.id }}')"
      aria-label="Add to Wishlist"
    >
      <svg class="w-4 h-4 wishlist-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
      </svg>
    </button>

    <!-- Primary Image -->
    <img 
      src="{{ img_1 }}" 
      alt="{{ product.title | escape }}" 
      class="img-primary absolute inset-0 w-full h-full object-contain p-4 transition-all duration-500 ease-out"
      loading="lazy"
    />
    <!-- Secondary Angle Image on Hover -->
    <img 
      src="{{ img_2 }}" 
      alt="{{ product.title | escape }} alternate angle" 
      class="img-secondary absolute inset-0 w-full h-full object-contain p-4 transition-all duration-500 ease-out"
      loading="lazy"
    />
  </div>

  <!-- Product Meta -->
  <div class="mt-3 pt-3 border-t border-[#f0f0f0]">
    <div class="flex justify-between items-start mb-1 gap-2">
      <div>
        <h3 class="text-sm font-black uppercase text-[#111111] group-hover:text-black tracking-tight leading-snug">
          {{ product.title }}
        </h3>
        {% if product.vendor and product.vendor != product.title %}
          <p class="text-[11px] font-semibold uppercase tracking-wider text-[#777777] mt-0.5">
            {{ product.vendor }}
          </p>
        {% endif %}
      </div>
      <span class="text-sm font-black text-[#111111] whitespace-nowrap">
        {{ product.price | money }}
      </span>
    </div>
  </div>
</div>
